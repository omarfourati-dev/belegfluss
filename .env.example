# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
DATABASE_PASSWORD=belegfluss

# JWT signing key, at least 32 characters (e.g. openssl rand -hex 32)
JWT_SECRET=
# First admin, created on start if no admin exists
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Public read-only account demo@belegfluss.app / demo-belegfluss
DEMO_ENABLED=false

# Optional: use Google Gemini via its OpenAI-compatible API instead of OpenAI
# AI_BASE_URL=https://generativelanguage.googleapis.com
# AI_COMPLETIONS_PATH=/v1beta/openai/chat/completions
# AI_MODEL=gemini-2.5-flash
